# Puerto donde corre el servidor (por defecto 3001)
PORT=3001

# Contraseña para acceder al panel de admin en /admin
# Cambiala antes de deployar en producción
ADMIN_SECRET=trivia-admin

# Directorio donde se guarda la base de datos SQLite
# En Railway: /data (volume mount)
# En local: se omite (usa server/data/ por defecto)
DATA_PATH=/data
